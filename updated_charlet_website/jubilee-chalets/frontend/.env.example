# Backend API URL (leave blank to use Vite proxy in dev, or set full URL for production)
VITE_API_URL=

# Media URL (base URL for uploaded images)
VITE_MEDIA_URL=http://localhost:8000

# Paystack public key (used only if embedding Paystack inline widget)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
